# Preferred provider; uses the model IDs configured for this Google AI Studio key.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_MAX_MODEL_ATTEMPTS=3
GEMINI_REQUEST_TIMEOUT_MS=12000

# Optional independent backup. If Gemini is busy or fails, OpenAI is tried automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_MS=20000

# Backend deployment settings (configure these in the hosting provider, not in Git).
AUTH_SECRET_KEY=replace_with_a_long_random_secret
AUTH_COOKIE_SECURE=true
FRONTEND_ORIGINS=https://YOUR-FRONTEND.onrender.com
DATABASE_PATH=/var/data/gen3d_edu.db

# Frontend build setting; set to your deployed backend URL.
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
